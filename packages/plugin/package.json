{
  "name": "@tyr1105/dsh-buddy",
  "private": true,
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：你的 OPC 专业团队。像素办公室显示每位队友的状态，自主节奏和每日上限由你定。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "ai-agents",
    "multi-agent",
    "ai-team",
    "opc",
    "pixel-art"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyr1105/dsh-buddy.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://tyr1105.github.io/dsh-buddy-landing/",
  "bugs": {
    "url": "https://github.com/tyr1105/dsh-buddy/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@agent-hub/core": "workspace:*",
    "@types/react": "^18.3.12"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
